# Copy to apps/mobile/.env for the app. Nothing here is required to run.

# Where the Worker lives. Leave blank to use the public Huli API.
VITE_API_BASE=https://huli-api.olin-lagon.workers.dev

# Optional. ArcGIS Location Platform key for sharp Esri World Imagery (free tier, 2M tiles/month).
# Without it the app uses USGS imagery, which is public domain and needs no key.
VITE_ESRI_KEY=

# Optional. Mapillary client token for Ground view rounds.
VITE_MAPILLARY_TOKEN=

# Worker secrets (set with `wrangler secret put NAME` in services/api, or in services/api/.dev.vars locally)
# ADMIN_TOKEN=        long random string, used for /admin/* routes
# DAILY_SEED_SECRET=  long random string, seeds the daily picker so future days can't be predicted
